        <mxCell id="note" value="Thanh biểu thị cửa sổ kế hoạch, không phải phần trăm hoàn thành hoặc nhật ký thực hiện." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="650" height="30" as="geometry"/></mxCell>
